{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "config": {
    "view": {
      "stroke": null
    }
  },
  "data": {
    "url": "data/abs_all_years_density.csv"
  },
  "params": [
    {
      "name": "Select_Year",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 1981,
        "max": 2025,
        "step": 1,
        "name": "Timeline (Year): "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.Year == Select_Year"
    },
    {
      "lookup": "State",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
          "format": {
            "property": "features"
          }
        },
        "key": "properties.STATE_NAME"
      },
      "as": "geo"
    }
  ],
  "projection": {
    "type": "mercator",
    "center": [133.5, -27],
    "scale": 700
  },
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1.2
  },
  "encoding": {
    "shape": {
      "field": "geo",
      "type": "geojson"
    },
    "color": {
      "field": "Density",
      "type": "quantitative",
      "scale": {
        "type": "log",
        "scheme": "oranges",
        "domain": [0.1, 200]
      },
      "title": null,
      "legend": {
        "title": "Population Density (people / km²)",
        "orient": "top-right",          
        "direction": "horizontal",    
        "gradientLength": 200,        
        "gradientThickness": 15,      
        "titlePadding": 12,
        "titleFontSize": 11,
        "labelFontSize": 10
      }
    },
    "tooltip": [
      {
        "field": "State",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "Year",
        "type": "quantitative",
        "title": "Year"
      },
      {
        "field": "Population",
        "type": "quantitative",
        "format": ",",
        "title": "Total Population"
      },
      {
        "field": "Density",
        "type": "quantitative",
        "format": ".2f",
        "title": "Density (per km²)"
      }
    ]
  }
}